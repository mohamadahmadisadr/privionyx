<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No receipt data leaves the device. Receipts are parsed on-device by Vision and the
	     built-in extractors, and the assistant is either Apple's on-device model or Gemma
	     running locally. The app's own outbound requests are the model download — a GET for a
	     public file, carrying no user data — and nothing else.

	     False despite the app serving AdMob banners, and that is a claim this app can make
	     only because of two deliberate choices: every request sets npa=1, and the IDFA is
	     never read, so there is no App Tracking Transparency prompt and no identifier being
	     joined to anything across apps. Change either one and this key has to become true. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Empty because this app's own code collects nothing. It is not a statement about the
	     whole binary: the Google Mobile Ads and User Messaging Platform frameworks each ship
	     their own manifest declaring what they collect, and Xcode aggregates all three into
	     the privacy report generated from the archive.

	     That report is what the App Store Connect answers must match, and those answers are
	     not derived from this file — they are filled in by hand and are currently the one
	     place the ad SDK's collection has to be declared. See RELEASE.md. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Required-reason APIs. Apple rejects an upload that uses one of these without a
	     declaration, so each entry names a real call site rather than a plausible one. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- GemmaModelManager reads the size of the downloaded model, both to verify a
			     finished transfer and to decide on launch whether one is already installed.
			     C617.1 covers metadata of files inside the app's own container, which is
			     where Application Support/Privionyx/Models sits. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- GemmaModelManager.freeDiskSpace, called before starting a 2.6 GB download so
			     the app can refuse rather than fill the device. E174.1 is exactly that: a
			     check for sufficient space before writing files. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
		<dict>
			<!-- The monthly budget, learned merchant rules, and the flags recording which
			     one-off migrations have run. All of it this app's own, read back only by this
			     app: CA92.1. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
